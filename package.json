{
  "name": "story-workbench-desktop",
  "version": "0.3.13",
  "description": "用于编写连续剧情并预演文字、场景与声音的 Windows 桌面工具。",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "preview:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "dist:dir": "npm run build && electron-builder --dir --win",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "jszip": "3.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "local.storyworkbench.desktop",
    "productName": "剧情创作工作台",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "剧情创作工作台",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
